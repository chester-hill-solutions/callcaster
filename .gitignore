# Local generated files
/public/exports/
.local/
.repl/
.issue-triage/

# Campaign data exports (PII: contact names, phone numbers, SMS message bodies).
# Anchored to the repo root so the tracked e2e fixtures under
# e2e/fixtures/files/ are unaffected. These are written by
# .opencode/tools/campaign-sms-report.sh, which puts them in the repo root by
# default; never commit them.
/*.csv
/*.pdf
/graphify-out/cost.json
/graphify-out/cache/
/graphify-out/.graphify_python
/graphify-out/.graphify_root

# Playwright E2E
/e2e/.auth/
/e2e/test-results/
/e2e/playwright-report/
/e2e/sim-playwright-report/
/playwright-report/
/test-results/

# OS/editor noise
.DS_Store
*.swp

# Local tooling folders are tracked.
skills-lock.json

# Secrets — never commit
app/transcribe.json
*.serviceaccount.json
scripts/dev/certs/
/CLIPBOARD.md
# Object storage (stow) — downloaded release binary, pidfile and bucket data
/.stow-bin/
/.stow/

# Isolated optional Graphify tool
/.opencode/.graphify-venv/

/graphify-out/.graphify_usage_unknown
