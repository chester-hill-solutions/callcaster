# syntax=docker/dockerfile:1
FROM oven/bun:1.2.15-slim
WORKDIR /app

# vendor/ must be present before install — package.json has file:vendor deps
COPY package.json bun.lock ./
COPY vendor ./vendor
RUN bun install --frozen-lockfile --production

COPY --chown=bun:bun app ./app
COPY --chown=bun:bun shared ./shared
COPY --chown=bun:bun worker ./worker
# Bun resolves the "@/*" import alias from tsconfig paths at runtime
COPY --chown=bun:bun tsconfig.json ./tsconfig.json

ENV NODE_ENV=production

USER bun

CMD ["bun", "worker/index.ts"]
