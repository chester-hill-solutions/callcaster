# ── Database (required) ──────────────────────────────────────────────
# Compose dev stack: docker compose -f docker-compose.dev.yml up -d postgres
DATABASE_URL=postgresql://callcaster:callcaster@127.0.0.1:5433/callcaster
# Optional direct (non-pooled) connection; defaults to DATABASE_URL.
# DATABASE_DIRECT_URL=

# ── Auth (required) ──────────────────────────────────────────────────
# Any long random string locally; generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=dev-better-auth-secret-change-me
# Defaults to BASE_URL when unset.
# BETTER_AUTH_URL=

# ── Object storage (required) ────────────────────────────────────────
# Local dev: MinIO from docker-compose.dev.yml (console at http://127.0.0.1:9001)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=callcaster
S3_SECRET_ACCESS_KEY=callcaster-dev-secret
S3_BUCKET=callcaster
# Railway Buckets (review/prod): use the bucket's auto-injected credentials instead
# of S3_* — ENDPOINT, REGION, ACCESS_KEY_ID, SECRET_ACCESS_KEY, BUCKET.
# See https://docs.railway.com/storage-buckets
# Optional dedicated buckets (override the single-bucket prefix layout).
# S3_BUCKET_AUDIO=
# S3_BUCKET_MEDIA=
# S3_BUCKET_EXPORTS=

# ── Public base URL (required) ───────────────────────────────────────
# Set to your current Localtunnel HTTPS URL when testing Twilio callbacks locally.
BASE_URL=http://localhost:3000

# Set to true/1 on non-prod deployments (review, local). Omit on production.
SIGNUP_OPEN=true

# ── Twilio (required; real credentials needed for calling/SMS) ───────
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+15555550100

# Optional. Set to false or 0 only for local tunnel dev; never disable in production.
# TWILIO_VALIDATE_WEBHOOKS=false

# Optional. Enables a lazy Twilio Lookup v2 line-type check on a contact's first
# SMS attempt so landlines are skipped instead of billed for a failed send.
# Result is cached forever on the contact (line_type column). Costs $0.008 per
# lookup (only paid once per contact). Off by default.
# TWILIO_LOOKUP_ENABLED=true

# Required. Internal ops-alert recipient for Twilio compliance jobs (Trust Hub
# bundles needing docs / terminal provisioning failures).
TWILIO_COMPLIANCE_NOTIFY_EMAIL=compliance@callcaster.ca

# Optional. Overrides the Trust Hub secondary customer-profile policy SID used
# when creating compliance bundles. Confirm the default in the code before go-live.
# TWILIO_TRUSTHUB_SECONDARY_POLICY_SID=RNxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Billing & email (required keys; placeholders fine until used) ────
STRIPE_SECRET_KEY=sk_test_placeholder
# Required for Stripe webhook endpoint (api.stripe-webhook). From Stripe Dashboard → Developers → Webhooks → Add endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_placeholder
RESEND_API_KEY=re_placeholder

# ── Scheduled jobs ───────────────────────────────────────────────────
# Shared secret for the cron-triggered job endpoints (/api/jobs/*). The
# endpoints return 401 for every caller — including your scheduler — until
# this is set and sent as the x-cron-secret header.
CRON_SECRET=dev-cron-secret-change-me

# Shared phone number for call-in 2FA verification.
# Configure this number's Voice URL in Twilio Console to: ${BASE_URL}/api/inbound-verification
VERIFICATION_PHONE_NUMBER=

# Media-stream Bun service (used by dashboard/$id and AudioStreamer).
# MEDIA_STREAM_HOST defaults to localhost:3001 in development.
# MEDIA_STREAM_SECRET has a dev-only fallback; production refuses to start without a real value.
MEDIA_STREAM_HOST=localhost:3001
MEDIA_STREAM_SECRET=dev-media-stream-secret-change-me
# Max concurrent WebSocket connections per workspace on the media-stream service (default 10).
# MEDIA_STREAM_MAX_PER_WORKSPACE=10
