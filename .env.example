# ── Database (required) ──────────────────────────────────────────────
# Compose dev stack: docker compose -f docker-compose.dev.yml up -d postgres
DATABASE_URL=postgresql://callcaster:callcaster@127.0.0.1:5433/callcaster
# Optional direct (non-pooled) connection; defaults to DATABASE_URL.
# DATABASE_DIRECT_URL=

# Per-statement timeout (milliseconds) before Postgres aborts a query and frees
# the connection. Default 30000 (30s). Prevents a missed index from holding the
# pool indefinitely.
# DB_STATEMENT_TIMEOUT_MS=30000

# Idle-in-transaction timeout (milliseconds) before Postgres closes a session
# that holds a transaction without activity. Default 60000 (60s). Prevents code
# paths that open a transaction and await something slow from deadlocking peers.
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

# ── Auth (required) ──────────────────────────────────────────────────
# Any long random string locally; generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=dev-better-auth-secret-change-me
# Defaults to BASE_URL when unset.
# BETTER_AUTH_URL=
# Extra origins for Better Auth CSRF (comma-separated). Needed when the browser
# origin differs from BASE_URL (e.g. www vs apex). Loopback is auto-trusted in
# non-production so Localtunnel BASE_URL + localhost:3000 signup still works.
# BETTER_AUTH_TRUSTED_ORIGINS=https://www.callcaster.ca
# APP_TRUSTED_ORIGINS=https://www.callcaster.ca

# Skip auth rate-limit enforcement (E2E suites, local dev). Honored only outside
# Railway production — silently ignored if it leaks into production config.
# DISABLE_AUTH_RATE_LIMIT=

# ── Object storage (required) ────────────────────────────────────────
# Local dev: MinIO from docker-compose.dev.yml (console at http://127.0.0.1:9001)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=callcaster
S3_SECRET_ACCESS_KEY=callcaster-dev-secret
S3_BUCKET=callcaster
# Railway Buckets (review/prod): use the bucket's auto-injected credentials instead
# of S3_* — ENDPOINT, REGION, ACCESS_KEY_ID, SECRET_ACCESS_KEY, BUCKET.
# See https://docs.railway.com/storage-buckets
# Optional dedicated buckets (override the single-bucket prefix layout).
# S3_BUCKET_AUDIO=
# S3_BUCKET_MEDIA=
# S3_BUCKET_EXPORTS=

# Force S3 URL style (path-style vs virtual-hosted). Set to "true" or "1" for
# path-style (e.g. minio, some S3-compatible backends), "false" or "0" for
# virtual-hosted. Omit to auto-detect by endpoint. Default: auto-detect.
# S3_FORCE_PATH_STYLE=

# Explicitly set S3 URL style by name. Accepts "path", "path-style", "virtual",
# "virtual-hosted", or "virtual-hosted-style". Overridden by S3_FORCE_PATH_STYLE
# if both are set. Default: auto-detect from endpoint.
# S3_URL_STYLE=

# ── Public base URL (required) ───────────────────────────────────────
# Set to your current Localtunnel HTTPS URL when testing Twilio callbacks locally.
BASE_URL=http://localhost:3000

# Set to true/1 on non-prod deployments (review, local). Omit on production.
SIGNUP_OPEN=true

# Apply client migrations (client/migrations/*.sql) at boot. Only runs when set
# to "1" or "true". Needed for ephemeral PR-preview databases; production never
# sets this. Off by default.
# RUN_CLIENT_MIGRATIONS_ON_BOOT=

# ── Twilio (required; real credentials needed for calling/SMS) ───────
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+15555550100

# Optional. Set to false or 0 only for local tunnel dev; never disable in production.
# TWILIO_VALIDATE_WEBHOOKS=false

# Optional. Enables a lazy Twilio Lookup v2 line-type check on a contact's first
# SMS attempt so landlines are skipped instead of billed for a failed send.
# Result is cached forever on the contact (line_type column). Costs $0.008 per
# lookup (only paid once per contact). Off by default.
# TWILIO_LOOKUP_ENABLED=true

# Required. Internal ops-alert recipient for Twilio compliance jobs (Trust Hub
# bundles needing docs / terminal provisioning failures).
TWILIO_COMPLIANCE_NOTIFY_EMAIL=compliance@callcaster.ca

# Optional. Overrides the Trust Hub secondary customer-profile policy SID used
# when creating compliance bundles. Confirm the default in the code before go-live.
# TWILIO_TRUSTHUB_SECONDARY_POLICY_SID=RNxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Overrides the A2P 10DLC Messaging Trust Product policy SID used when
# creating brand registrations. Confirm the default in the code before go-live.
# TWILIO_A2P_MESSAGING_POLICY_SID=RNxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Observability (all optional) ─────────────────────────────────────
# Where ops alerts go (dead-lettered money jobs, worker crashes, elevated 5xx
# rate). Falls back to TWILIO_COMPLIANCE_NOTIFY_EMAIL, which itself defaults to
# info@callcaster.ca. Emails only send when NODE_ENV=production.
# OPS_ALERT_EMAIL=ops@callcaster.ca
# Set to "false" to silence ops emails without unwiring the alerts.
# OPS_ALERT_EMAILS_ENABLED=false
# Optional upgrade: with a DSN set, every notifyOps call and 5xx also reaches
# Sentry. Everything works without it.
# SENTRY_DSN=https://...ingest.sentry.io/...

# Exit the web process on unhandled promise rejection. Set to "1" or "true" to
# enable. Default: false (rejections are logged but don't crash the process).
# PROCESS_FATAL_ON_REJECTION=

# Shared secret gating the Event Streams sink route (/api/twilio/a2p/events).
# Configure the Twilio sink destination URL with ?token=<this value>. When
# webhook validation is on and this is unset, the route rejects every request.
# TWILIO_EVENTS_SINK_SECRET=generate_a_long_random_value

# ── Billing & email (required keys; placeholders fine until used) ────
STRIPE_SECRET_KEY=sk_test_placeholder
# Required for Stripe webhook endpoint (api.stripe-webhook). From Stripe Dashboard → Developers → Webhooks → Add endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_placeholder
RESEND_API_KEY=re_placeholder

# ── Scheduled jobs ───────────────────────────────────────────────────
# Shared secret for the cron-triggered job endpoints (/api/jobs/*). The
# endpoints return 401 for every caller — including your scheduler — until
# this is set and sent as the x-cron-secret header.
CRON_SECRET=dev-cron-secret-change-me

# Shared phone number for call-in 2FA verification.
# Configure this number's Voice URL in Twilio Console to: ${BASE_URL}/api/inbound-verification
VERIFICATION_PHONE_NUMBER=

# Two-factor authentication is OFF unless this is set. When set: enrolled users
# are asked for a code at sign-in and owner/admin roles must enroll.
# TWO_FACTOR_ENABLED=1

# With TWO_FACTOR_ENABLED=1: skip only the privileged-role enrollment gates
# (local dev, E2E, Railway PR previews). Never honored on Railway production.
# DISABLE_2FA_ENFORCEMENT=1

# Media-stream Bun service (used by dashboard/$id and AudioStreamer).
# MEDIA_STREAM_HOST defaults to localhost:3001 in development.
# MEDIA_STREAM_SECRET has a dev-only fallback; production refuses to start without a real value.
MEDIA_STREAM_HOST=localhost:3001
MEDIA_STREAM_SECRET=dev-media-stream-secret-change-me
# Port the media-stream service listens on (default 3001).
# MEDIA_STREAM_PORT=3001
# Max concurrent WebSocket connections per workspace on the media-stream service (default 10).
# MEDIA_STREAM_MAX_PER_WORKSPACE=10

# Live transcription + coaching (media-stream service and the post-call
# elevenlabs_batch_transcribe worker job).
# ELEVENLABS_API_KEY powers live STT (scribe_v2_realtime) and the batch golden
# transcript (scribe_v2). If unset, live STT is skipped; the batch worker job
# THROWS and dead-letters every ~15 min, so set it wherever the worker runs.
# ELEVENLABS_API_KEY=
# COHERE_API_KEY powers live coaching cues (api.cohere.com generate). If unset,
# coaching cues are skipped.
# COHERE_API_KEY=
