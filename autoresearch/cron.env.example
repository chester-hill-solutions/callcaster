# Copy to cron.env and edit. Never commit cron.env.

# Run tag — branch becomes autoresearch/<tag>
AUTORESEARCH_TAG=pilot1

# Builder (loop turns). x-preview-f-free is the free pilot; swap to
# opencode/claude-opus-5 (~$15-25/night) if kept-turn rate disappoints.
AUTORESEARCH_MODEL=opencode/x-preview-f-free

# Reviewer (batch diff audit). GPT-5.6 Sol at 50% off until Sep 18 2026.
# Alternatives: opencode/claude-sonnet-5 ($2/$10)
AUTORESEARCH_REVIEW_MODEL=opencode/gpt-5.6-sol

# Remediator defaults to the builder model.
AUTORESEARCH_REMEDIATE_MODEL=opencode/x-preview-f-free

# Loop knobs
AUTORESEARCH_MAX_TURNS=5
AUTORESEARCH_TIMEOUT_SECS=7200
AUTORESEARCH_REVIEW=1
AUTORESEARCH_REVIEW_MAX_ROUNDS=2
AUTORESEARCH_PUSH=1
AUTORESEARCH_REMOTE=origin
