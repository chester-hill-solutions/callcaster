+
+  test("SCAN: stops new sends when the window closes during a paced batch", async () => {
+    vi.useFakeTimers();
+    vi.setSystemTime(new Date("2026-09-09T20:59:59.750Z"));
+    try {
+      const actual = await vi.importActual<typeof import("@/lib/campaign-send-window")>("@/lib/campaign-send-window");
+      mocks.isWithinSendWindow.mockImplementation(actual.isWithinSendWindow);
+      mocks.loadCampaignSmsDispatchData.mockResolvedValue({
+        ...baseCampaignData(),
+        campaign: { ...baseCampaignData().campaign,
+          sms_send_window: { wednesday: { active: true, intervals: [{ start: "09:00", end: "21:00" }] } },
+        },
+      });
+      mocks.getWorkspaceTwilioPortalConfig.mockResolvedValue({ ...basePortal, parallelDispatchEnabled: true, smsTargetMps: 2 });
+      const sendTimes: string[] = [];
+      mocks.createWorkspaceTwilioInstance.mockResolvedValue({ messages: { create: vi.fn(async (args: any) => {
+        sendTimes.push(new Date().toISOString());
+        return { sid: `SM${sendTimes.length}`, ...args };
+      }) } });
+      const { dispatchCampaignSmsBatch } = await import("@/lib/campaign-sms-dispatch.server");
+      const running = dispatchCampaignSmsBatch({ workspaceId: TEST_WORKSPACE_ID, campaignId: String(CAMPAIGN_ID), userId: USER_ID });
+      await vi.advanceTimersByTimeAsync(2000);
+      const result = await running;
+      console.log("SCAN boundary", JSON.stringify({sendTimes, result}));
+      expect(sendTimes).toEqual(["2026-09-09T20:59:59.750Z"]);
+    } finally { vi.useRealTimers(); }
+  });
+
+  test("SCAN: an eligible row behind a deferred head must receive a turn", async () => {
+    mocks.loadCampaignSmsDispatchData.mockResolvedValue(baseCampaignData());
+    const windows = await import("@/lib/recipient-calling-window");
+    vi.mocked(windows.recipientCallingWindowStatus).mockImplementation((phone) => ({
+      allowed: phone === TWO_ELIGIBLE_ROWS[1].contact.phone,
+      timezone: "America/Toronto", reason: "in_window",
+    }));
+    const { dispatchCampaignSmsBatch } = await import("@/lib/campaign-sms-dispatch.server");
+    const outcomes = [];
+    for (let i=0;i<2;i++) outcomes.push(await dispatchCampaignSmsBatch({ workspaceId: TEST_WORKSPACE_ID, campaignId: String(CAMPAIGN_ID), userId: USER_ID, maxContacts: 1 }));
+    console.log("SCAN starvation", JSON.stringify(outcomes));
+    expect(mocks.rpcCreateOutreachAttempt).toHaveBeenCalledTimes(1);
+  });
+  test("SCAN: a one-MPS target spaces sends across one-row batch boundaries", async () => {
+    vi.useFakeTimers(); vi.setSystemTime(new Date("2026-09-09T15:00:00Z"));
+    try {
+      mocks.loadCampaignSmsDispatchData.mockResolvedValue(baseCampaignData());
+      mocks.getWorkspaceTwilioPortalConfig.mockResolvedValue({...basePortal, parallelDispatchEnabled: true, smsTargetMps: 1});
+      const windows = await import("@/lib/recipient-calling-window");
+      vi.mocked(windows.recipientCallingWindowStatus).mockReturnValue({allowed: true, timezone: "America/Toronto", reason: "in_window"});
+      const sendTimes: number[] = [];
+      mocks.createWorkspaceTwilioInstance.mockResolvedValue({messages: {create: vi.fn(async(args: any) => {sendTimes.push(Date.now()); return {sid: `SM${sendTimes.length}`, ...args};})}});
+      const {dispatchCampaignSmsBatch} = await import("@/lib/campaign-sms-dispatch.server");
+      const running = dispatchCampaignSmsBatch({workspaceId: TEST_WORKSPACE_ID, campaignId: String(CAMPAIGN_ID), userId: USER_ID});
+      await vi.advanceTimersByTimeAsync(2000); await running;
+      console.log("SCAN one-MPS gaps", sendTimes[1]-sendTimes[0]);
+      expect(sendTimes[1]-sendTimes[0]).toBeGreaterThanOrEqual(1000);
+    } finally {vi.useRealTimers();}
+  });
+
