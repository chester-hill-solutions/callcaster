+describe("SCAN: missed dispatch boundaries", () => {
+  beforeEach(() => {
+    vi.resetModules();
+    seedCommonMocks();
+    mocks.getCampaignQueueById.mockResolvedValue(TWO_ELIGIBLE_ROWS);
