{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "railway": {
      "type": "local",
      "command": ["railway", "mcp"]
    },
    "servers": {
      "twilio": {
        "type": "remote",
        "url": "https://mcp.twilio.com/docs"
      }
    }
  },
  "plugins": [
    "./plugins/graphify.js"
  ]
}
